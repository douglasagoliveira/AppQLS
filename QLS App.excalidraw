    {
      "id": "21c830b5",
      "type": "text",
      "x": 73.75,
      "y": 307.5,
      "width": 601.4822387695312,
      "height": 311.2962962962963,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
